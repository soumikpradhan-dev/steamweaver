# StreamWeaver Environment Configuration
PORT=3000
HOST=0.0.0.0

# Bulk Sink Target Defaults
DEFAULT_BATCH_SIZE=1000
DEFAULT_DESTINATION=sqlite # 'sqlite' | 'mongodb' | 'ndjson'

# MongoDB Configuration (Optional - embedded SQLite is active by default)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=streamweaver
MONGODB_COLLECTION=transformed_records

# V8 Sandbox Limits
SANDBOX_TIMEOUT_MS=50
MAX_SANDBOX_MEMORY_MB=16
METRICS_INTERVAL_MS=200
